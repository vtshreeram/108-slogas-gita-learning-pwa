{
  "name": "nextjs-new",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "NODE_ENV=development next dev",
    "dev:turbo": "NODE_ENV=development next dev --turbopack",
