    "test:webkit": "node scripts/check-offline-webkit.mjs"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "clsx": "^2.1.1",
    "firebase": "^12.12.0",
    "lucide-react": "^0.554.0",
    "next": "^15.5.15",
    "next-themes": "^0.4.6",
    "orchids-visual-edits": "^1.0.13",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/eslintrc": "^3.3.5",
    "@tailwindcss/postcss": "^4.2.2",
    "@types/node": "^20.19.39",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.4",
    "eslint-config-next": "^15.5.15",
    "playwright": "^1.65.0",
    "react-grab": "^0.2.0",
    "tailwindcss": "^4.2.2",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.4"
