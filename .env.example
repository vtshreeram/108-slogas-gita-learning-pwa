# Cloud sync of learning progress (Firestore). Off by default.
# Build-time flag: changing it requires a redeploy.
# Before enabling: create Firestore in the Firebase project and run
#   firebase deploy --only firestore:rules
NEXT_PUBLIC_PROGRESS_SYNC=0

# Chapter audio host (Cloudflare R2 custom domain, no trailing slash). Inlined at build time: redeploy after changing.
# Local dev falls back to /chapter-audio (public/chapter-audio, gitignored).
NEXT_PUBLIC_CHAPTER_AUDIO_BASE=
